  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.5.2",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "eslint": "9.36.0",
    "eslint-config-next": "16.3.2",
    "genlayer": "0.39.1",
    "jsdom": "27.0.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
