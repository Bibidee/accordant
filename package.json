    "@testing-library/react": "16.3.0",
    "@types/node": "24.5.2",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "jsdom": "27.0.0",
    "typescript-eslint": "8.71.1",
    "typescript": "5.9.2",
